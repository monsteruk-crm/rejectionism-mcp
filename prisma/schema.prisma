// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Example data model
model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  email     String   @unique
  name      String?
}

enum WorkItemStatus {
  BACKLOG
  NEXT
  IN_PROGRESS
  BLOCKED
  DONE
}

enum AssetStatus {
  MISSING
  DRAFT
  NEEDS_WORK
  APPROVED
  SUPERSEDED
}

enum WebsiteStatus {
  PLANNED
  RESERVED
  IN_PROGRESS
  LIVE
  REDIRECT
  UNKNOWN
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum EntityType {
  WORK_ITEM
  CANON_ENTRY
  DECISION
  ASSET
  WEBSITE
  CONTACT
  CONTENT_ITEM
  UPLOAD_REQUEST
  TAG
  ENTITY_RELATION
  CAMPAIGN_MEMORY
}

enum MemoryCategory {
  PREFERENCE
  CONTEXT
  INSTRUCTION
  LESSON
  PERSON
  PROJECT
  STYLE
  PROCESS
  TECHNICAL
  REFERENCE
  OTHER
}

enum MemoryStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum MemorySourceType {
  HUMAN
  MCP
  ADMIN
  IMPORT
  SYSTEM
}

enum AssetStorageType {
  BLOB
  EXTERNAL_URL
}

enum UploadRequestStatus {
  OPEN
  SUBMITTED
  REVOKED
}

enum UploadRequestPurpose {
  CONTRIBUTOR
  ADMIN_INTERNAL
}

enum UploadFileStatus {
  PENDING
  VERIFIED
  REJECTED
  ATTACHED
  DISCARDED
}

enum EntityRelationType {
  RELATES_TO
  USES_ASSET
  PART_OF
}

model WorkItem {
  id             String         @id @default(cuid())
  title          String
  description    String         @default("")
  status         WorkItemStatus @default(BACKLOG)
  priority       Int            @default(0)
  dueDate        DateTime?
  blockedReason  String?
  evidenceUrl    String?
  completionNote String?
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, priority])
  @@index([dueDate])
}

model CanonEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String
  notes     String?
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model Decision {
  id           String    @id @default(cuid())
  subject      String
  decision     String
  rationale    String
  supersedesId String?   @unique
  decidedAt    DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supersedes   Decision? @relation("DecisionSupersession", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy Decision? @relation("DecisionSupersession")

  @@index([decidedAt])
}

model Asset {
  id             String      @id @default(cuid())
  name           String
  kind           String
  status         AssetStatus @default(DRAFT)
  sourceFilename String?
  url            String?
  notes          String?
  version        Int         @default(1)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  revisions            AssetRevision[]
  uploadRequests       UploadRequest[]      @relation("UploadTargetAsset")
  legacyRepresentation AssetRepresentation? @relation("LegacyAssetRepresentation")

  @@index([status])
  @@index([kind])
}

model Website {
  id            String        @id @default(cuid())
  name          String
  domain        String        @unique
  purpose       String
  status        WebsiteStatus @default(UNKNOWN)
  repositoryUrl String?
  deploymentUrl String?
  notes         String?
  version       Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Contact {
  id           String   @id @default(cuid())
  name         String
  organization String?
  role         String?
  email        String?
  status       String   @default("PROSPECT")
  notes        String?
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContentItem {
  id           String        @id @default(cuid())
  title        String
  format       String
  channel      String
  status       ContentStatus @default(DRAFT)
  scheduledFor DateTime?
  publishedUrl String?
  notes        String?
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([scheduledFor])
}

model Activity {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  action     String
  summary    String
  metadata   Json?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
}

model AssetRevision {
  id             String   @id @default(cuid())
  assetId        String
  revisionNumber Int
  label          String?
  notes          String?
  createdAt      DateTime @default(now())
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  representations AssetRepresentation[]
  uploadRequests  UploadRequest[]

  @@unique([assetId, revisionNumber])
}

model AssetRepresentation {
  id              String           @id @default(cuid())
  assetRevisionId String
  storageType     AssetStorageType
  label           String?
  notes           String?
  variant         String?
  format          String?
  sourceFilename  String?
  mimeType        String?
  byteSize        BigInt?
  width           Int?
  height          Int?
  checksumSha256  String?          @db.Char(64)
  blobUrl         String?
  blobPathname    String?          @unique
  externalUrl     String?
  isPrimary       Boolean          @default(false)
  uploadFileId    String?          @unique
  uploadRequestId String?
  legacyAssetId   String?          @unique
  createdAt       DateTime         @default(now())
  assetRevision   AssetRevision    @relation(fields: [assetRevisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploadFile      UploadFile?      @relation(fields: [uploadFileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploadRequest   UploadRequest?   @relation(fields: [uploadRequestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  legacyAsset     Asset?           @relation("LegacyAssetRepresentation", fields: [legacyAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([assetRevisionId, createdAt])
  @@index([storageType])
  @@index([uploadRequestId])
}

model UploadRequest {
  id                     String               @id @default(cuid())
  tokenHash              String               @unique @db.Char(64)
  purpose                UploadRequestPurpose @default(CONTRIBUTOR)
  title                  String
  instructions           String               @default("")
  status                 UploadRequestStatus  @default(OPEN)
  expiresAt              DateTime
  maxItems               Int                  @default(20)
  targetAssetId          String?
  targetRevisionId       String?
  targetAssetVersion     Int?
  submissionKey          String?              @db.Uuid
  submissionHash         String?              @db.Char(64)
  submissionReceipt      Json?
  createdAt              DateTime             @default(now())
  submittedAt            DateTime?
  revokedAt              DateTime?
  replacesId             String?              @unique
  targetAsset            Asset?               @relation("UploadTargetAsset", fields: [targetAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetRevision         AssetRevision?       @relation(fields: [targetRevisionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replaces               UploadRequest?       @relation("UploadReplacement", fields: [replacesId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replacedBy             UploadRequest?       @relation("UploadReplacement")
  files                  UploadFile[]
  representations        AssetRepresentation[]

  @@index([status, expiresAt])
  @@index([createdAt, id])
  @@index([purpose, createdAt, id])
  @@index([purpose, status, expiresAt])
  @@index([targetAssetId])
  @@index([targetRevisionId])
}

model UploadFile {
  id                     String           @id @default(cuid())
  uploadRequestId        String
  clientItemId           String           @db.Uuid
  status                 UploadFileStatus @default(PENDING)
  sourceFilename         String
  declaredMimeType       String
  expectedByteSize       BigInt
  blobPathname           String           @unique
  blobUrl                String?
  mimeType               String?
  byteSize               BigInt?
  width                  Int?
  height                 Int?
  verifiedAt             DateTime?
  failureCode            String?
  authorizationCount     Int              @default(0)
  authorizationExpiresAt DateTime?
  deletedAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  uploadRequest          UploadRequest    @relation(fields: [uploadRequestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  representation         AssetRepresentation?

  @@unique([uploadRequestId, clientItemId])
  @@index([uploadRequestId, status])
}

// Generic tags and directed relationships (upgrade plan Phase 4). The
// polymorphic endpoints carry no database foreign keys; integrity is enforced
// by authored SQL constraints (original seven entity types, no self-relation)
// plus explicit service-side entity existence checks (ADR 0005).
model Tag {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  createdAt DateTime    @default(now())
  entities  EntityTag[]
}

model EntityTag {
  tagId      String
  entityType EntityType
  entityId   String
  createdAt  DateTime    @default(now())
  tag        Tag         @relation(fields: [tagId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([tagId, entityType, entityId])
  @@index([entityType, entityId])
}

model EntityRelation {
  id             String             @id @default(cuid())
  fromEntityType EntityType
  fromEntityId   String
  toEntityType   EntityType
  toEntityId     String
  relationType   EntityRelationType
  notes          String?
  createdAt      DateTime           @default(now())

  @@unique([fromEntityType, fromEntityId, toEntityType, toEntityId, relationType])
  @@index([fromEntityType, fromEntityId, createdAt])
  @@index([toEntityType, toEntityId, createdAt])
}

// CampaignOS persistent cross-tool memory (ADR 0007, brief section 2).
// Stable keys are optional but unique across all non-null statuses. contentHash
// uniqueness is enforced at the database boundary for ACTIVE rows only via an
// authored SQL partial index; historical SUPERSEDED/ARCHIVED rows may share a
// hash. Supersession is a single predecessor self-relation.
model CampaignMemory {
  id           String           @id @default(cuid())
  key          String?          @unique
  title        String
  content      String
  category     MemoryCategory
  status       MemoryStatus     @default(ACTIVE)
  importance   Int              @default(50)
  confidence   Int              @default(100)
  pinned       Boolean          @default(false)
  sourceType   MemorySourceType
  sourceLabel  String?
  sourceUrl    String?
  contentHash  String           @db.Char(64)
  version      Int              @default(1)
  accessCount  Int              @default(0)
  lastAccessedAt DateTime?
  expiresAt    DateTime?
  supersedesId String?          @unique
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  supersedes   CampaignMemory?  @relation("CampaignMemorySupersession", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy CampaignMemory?  @relation("CampaignMemorySupersession")

  @@index([category])
  @@index([importance])
  @@index([pinned])
  @@index([updatedAt])
  @@index([expiresAt])
  @@index([contentHash])
  @@index([status, expiresAt])
  @@index([lastAccessedAt, id])
}

# PostgreSQL connection string for the Prisma pg adapter.
# Use a direct postgresql:// URL (not a prisma+postgres:// Accelerate URL).
# Named MCP_PRISMA_DATABASE_URL because Vercel reserves DATABASE_URL.
MCP_PRISMA_DATABASE_URL=

# Single shared credential for admin login and MCP Bearer authentication.
# Must match [A-Za-z0-9_-]{32,256}; generate with: openssl rand -base64 48 |
# tr "+/" "-_" | tr -d "=" | tr -d "\n"
# Never commit the real value. Password rotation invalidates admin sessions
# and MCP credentials.
CAMPAIGNOS_PASSWORD=

# Absolute application origin used for session cookies, Server Action origin
# checks, and generated upload links. Must be an origin only (no path, query,
# credentials, or fragment). HTTPS required in production. Defaults to
# http://localhost:3000 outside production.
CAMPAIGNOS_BASE_URL=

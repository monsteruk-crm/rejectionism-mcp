# PostgreSQL connection string for the Prisma pg adapter.
# Use a direct postgresql:// URL (not a prisma+postgres:// Accelerate URL).
# Named MCP_PRISMA_DATABASE_URL because Vercel reserves DATABASE_URL.
MCP_PRISMA_DATABASE_URL=

# Single shared credential for admin login and MCP Bearer authentication.
# Must match [A-Za-z0-9_-]{32,256}; generate with: openssl rand -base64 48 |
# tr "+/" "-_" | tr -d "=" | tr -d "\n"
# Never commit the real value. Password rotation invalidates admin sessions
# and MCP credentials.
CAMPAIGNOS_PASSWORD=

# Absolute application origin used for session cookies, Server Action origin
# checks, and generated upload links. Must be an origin only (no path, query,
# credentials, or fragment). HTTPS required in production. Defaults to
# http://localhost:3000 outside production.
CAMPAIGNOS_BASE_URL=

# Private Vercel Blob read/write token for visual asset storage.
BLOB_READ_WRITE_TOKEN=

# ==============================================================================
# Testing & Development Configuration
# ==============================================================================

# Disposable PostgreSQL database connection string for integration and E2E suites.
# Must NOT match MCP_PRISMA_DATABASE_URL.
TEST_MCP_PRISMA_DATABASE_URL=

# Explicit operator acknowledgement that the test database is disposable (set to 1).
CAMPAIGNOS_TEST_DISPOSABLE=

# Base URL for test client and E2E browser test runners (e.g. http://localhost:3000).
CAMPAIGNOS_TEST_BASE_URL=

# Expected SHA-256 target database fingerprint for HTTP mutation test guards.
CAMPAIGNOS_TEST_EXPECTED_DATABASE_FINGERPRINT=

# Explicit operator acknowledgement that the Blob store is a disposable test store (set to 1).
CAMPAIGNOS_TEST_BLOB_DISPOSABLE=

# Optional explicit path to an environment file for test runners.
CAMPAIGNOS_TEST_ENV_FILE=

# ==============================================================================
# Staging Verification Configuration
# ==============================================================================

# Staging application origin for staging verification suite.
CAMPAIGNOS_STAGING_BASE_URL=

# Staging password / MCP Bearer token.
CAMPAIGNOS_STAGING_PASSWORD=

# Explicit operator acknowledgement for authorized staging write tests (set to 1).
CAMPAIGNOS_STAGING_WRITE_APPROVED=

# PostgreSQL connection string for the Prisma pg adapter.
# Use a direct postgresql:// URL (not a prisma+postgres:// Accelerate URL).
DATABASE_URL=

# Temporary unauthenticated test mode. The application fails closed for all
# campaign reads and writes unless this is exactly "true".
# This is NOT authentication. Do not store private or sensitive data.
UNAUTHENTICATED_TEST_MODE=true
